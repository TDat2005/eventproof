PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=event_proof_user
DATABASE_PASSWORD=event_proof_pass
DATABASE_NAME=event_proof
REDIS_HOST=localhost
REDIS_PORT=6380
# Daily uninstall cleanup; 0 is useful only with an isolated dev database.
# Mandatory shop/redact bypasses this retention.
UNINSTALL_RETENTION_DAYS=30
# Shopify CLI injects these when running `shopify app dev`.
# Configure them explicitly when starting the backend outside Shopify CLI.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Local testing only: NODE_ENV must be development and the shop must be listed.
# Set before creating a NEW test order; already processed orders stay unchanged.
# NODE_ENV=development
SALES_TEST_ORDER_SHOPS=
